SNAPIFY_DISTRIBUTION=cms
SEED_DEMO=false

PORT=3000

# PostgreSQL (obligatoire)
DATABASE_URL=postgres://snapify:changez-moi@127.0.0.1:5432/snapify
# Conteneur Docker local (npm run db:up)
SNAPIFY_DB_PASSWORD=changez-moi
SNAPIFY_DB_PORT=5433

# URL publique du site (utilisée au premier démarrage pour settings.publicUrl)
PUBLIC_URL=https://exemple.tn
SNAPIFY_PUBLIC_URL=https://exemple.tn

# Module « Assistant IA » (novalabs.ai-chat) — clé lue uniquement côté serveur
GEMINI_API_KEY=

# Community + Marketplace + portail développeurs (sous-domaines)
COMMUNITY_HOST=community.snapify.tn,community.snapify.fr,community.localhost
MARKETPLACE_HOST=marketplace.snapify.tn,marketplace.snapify.fr,marketplace.localhost
DEVELOPERS_HOST=developers.snapify.tn,developers.snapify.fr,developers.localhost
COMMUNITY_URL=https://community.snapify.tn
MARKETPLACE_PUBLIC_URL=https://marketplace.snapify.tn
PLATFORM_PUBLIC_URL=https://marketplace.snapify.tn
# Domaine cookie dérivé du Host (.snapify.tn / .snapify.fr) ; fallback :
PLATFORM_ADMIN_EMAIL=admin@snapify.tn
PLATFORM_ADMIN_PASSWORD=SnapifyAdmin1
MARKETPLACE_COMMISSION_BPS=3000
DEVELOPER_FEE_MILLIMES=100000
# true = paiements simulés — ignoré / interdit si NODE_ENV=production

# Modules — catalogue distant HTTPS (vide = catalogue local marketplace/catalog.json)
# Pointer vers le catalogue généré par la plateforme :
# MARKETPLACE_URL=https://marketplace.snapify.tn/api/marketplace/catalog.json
MARKETPLACE_URL=
# true = autorise l'installation de modules non signés (développement uniquement)
SNAPIFY_MODULES_DEV_MODE=false

# Backoffice — changez impérativement en production
ADMIN_EMAIL=admin@snapify.fr
ADMIN_PASSWORD=changez-moi
ADMIN_JWT_SECRET=long-random-secret
# Clé de chiffrement des secrets en base (mot de passe SMTP, 2FA). Vide = dérivée d'ADMIN_JWT_SECRET.
# Ne plus la changer une fois définie : les secrets déjà chiffrés deviendraient illisibles.
SNAPIFY_SECRET_KEY=
# Adresse de l'administration utilisée dans les e-mails (invitation, mot de passe oublié). Vide = URL publique du site.
SNAPIFY_ADMIN_URL=
# Secours : true = ignore la liste d'IP autorisées de l'administration (à remettre à false après usage)
SNAPIFY_ADMIN_IP_BYPASS=false

# Google OAuth (Search Console) — facultatif : l'assistant SEO › Google Search Console
# permet de saisir ces identifiants dans l'admin (prioritaires, secret chiffré).
# GOOGLE_REDIRECT_URI n'est utilisé qu'avec les identifiants définis ici.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://snapify.fr/api/admin/google/callback

# E-mails (formulaires, newsletter double opt-in, invitations). Utilisé seulement si le SMTP
# n'est pas configuré dans Paramètres › E-mails, qui a priorité.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=contact@snapify.fr

# Démo publique snapify.tn/demo (credentials affichés + reset CMS 24h)
DEMO_ADMIN_EMAIL=admin@snapify.fr
DEMO_ADMIN_PASSWORD=SnapifyDemo1
DEMO_CMS_RESET=true
DEMO_CMS_RESET_HOURS=24
LICENSE_PRICE_MILLIMES=699000

# Superadmin (https://snapify.tn/hamdisup90) — SUPERADMIN_PASSWORD obligatoire (pas de défaut)
