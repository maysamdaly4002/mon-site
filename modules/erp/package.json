{
  "name": "snapify-erp-incendie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Module de prévention incendie pour ERP : établissements, équipements (QR), contrôles, non-conformités, registre de sécurité infalsifiable.",
  "scripts": {
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx adapters/postgres/migrate.ts",
    "db:seed": "tsx adapters/postgres/seed.ts",
    "start": "tsx src/standalone.ts"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
