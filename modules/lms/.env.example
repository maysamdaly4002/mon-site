# PostgreSQL local (docker compose up -d) ou Neon (ajouter ?sslmode=require)
DATABASE_URL=postgresql://lms:lms@localhost:5432/lms
# API autonome (npm start) : secret de signature des jetons, 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
LMS_JWT_SECRET=remplacez-par-une-longue-valeur-aleatoire-0123456789
PORT=3000
# Taille maximale du pool de connexions PostgreSQL (défaut 10)
PGPOOL_MAX=10

# Habillage du certificat PDF (facultatif ; dans Snapify, ces valeurs sont des réglages du module)
LMS_ORGANISATION=
LMS_SIGNATORY=
# Page de vérification publique, ex. https://www.mon-site.tn/formation/verifier/ (le code est ajouté automatiquement)
LMS_VERIFY_URL=
