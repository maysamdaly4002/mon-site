{
  "info": {
    "name": "API LMS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Comptes de démonstration : admin@demo.tn, instructeur@demo.tn, apprenant@demo.tn, sami@demo.tn, auditeur@demo.tn (mot de passe Demo1234!). Lancez d'abord « Connexion »."
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "POST /auth/login — Connexion (enregistre le jeton)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const r = pm.response.json(); if (r.token) pm.collectionVariables.set('token', r.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{base}}/auth/login",
          "host": [
            "{{base}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"instructeur@demo.tn\",\n  \"password\": \"Demo1234!\"\n}"
        }
      }
    },
